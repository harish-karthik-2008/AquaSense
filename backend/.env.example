# AquaSense AI Environment Configuration

# Server host & port
PORT=8000
HOST=0.0.0.0

# MongoDB URI (default connects to local instance; if offline, automatically falls back to persistent storage)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=aquasense_ai

# Wokwi / ESP32 Configuration
ESP32_DEVICE_ID=AquaSense-ESP32
HEARTBEAT_TIMEOUT_SECONDS=25

